{
  "name": "pixelfm",
  "version": "2.1.1",
  "description": "PixelFM: a cyberpunk DJ booth for your terminal. Search and play YouTube audio with real-time meters. Installs the `party` command.",
  "license": "MIT",
  "keywords": [
    "music",
    "youtube",
    "terminal",
    "tui",
    "player",
    "dj",
    "cli"
  ],
  "bin": {
    "party": "bin/party.js"
  },
  "files": [
    "bin/",
    "lib/",
    "python/requirements.lock",
    "python/*.whl",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "scripts": {
    "build:wheel": "node scripts/build-wheel.js",
    "prepack": "node scripts/build-wheel.js",
    "test": "node --test test/launcher.test.js"
  }
}
