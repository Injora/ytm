{
  "name": "pixelfm",
  "version": "2.4.0",
  "description": "PixelFM: a cyberpunk DJ booth for your terminal. Search and play YouTube audio with real-time meters. Installs the `pixelfm` command (and its short form `pfm`).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Injora/ytm.git"
  },
  "homepage": "https://github.com/Injora/ytm#readme",
  "bugs": {
    "url": "https://github.com/Injora/ytm/issues"
  },
  "keywords": [
    "music",
    "youtube",
    "terminal",
    "tui",
    "player",
    "dj",
    "cli"
  ],
  "bin": {
    "pixelfm": "bin/pixelfm.js",
    "pfm": "bin/pixelfm.js"
  },
  "files": [
    "bin/",
    "lib/",
    "python/requirements.lock",
    "python/*.whl",
    "README.md",
    "CHANGELOG.md",
    "docs/GUIDE.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "scripts": {
    "build:wheel": "node scripts/build-wheel.js",
    "build:helper": "node scripts/build-helper.js",
    "prepack": "node scripts/build-wheel.js",
    "test": "node --test test/launcher.test.js test/system-deps.test.js"
  }
}
